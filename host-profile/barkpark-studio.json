{
  "host": "barkpark-studio",
  "root": "..",
  "minContract": "1.21.0",
  "fleet": true,
  "sources": [
    "app/src/components/PortableDocEditor.tsx",
    "app/src/components/CanvasChrome.tsx",
    "app/src/components/Fields.tsx",
    "app/src/lib/canvas-bundle.ts",
    "app/src/lib/canvas-focus.ts",
    "app/src/lib/fleet.ts",
    "app/src/styles.css"
  ],
  "uses": {
    "canvas": {
      "DOM attribute": [
        "data-bp-fleet-body",
        "data-bp-fleet-id",
        "data-bp-id",
        "data-wikilink"
      ],
      "ancestor attribute": [
        "data-paper-masters",
        "data-strings",
        "data-theme"
      ],
      "attribute": [
        "block-cards",
        "data-field-caps",
        "data-vocabulary",
        "editable"
      ],
      "class": [
        "bp-comment-range",
        "bp-comment-range--active",
        "bp-remote-caret__label"
      ],
      "event": [
        "bp-canvas-history",
        "bp-canvas-node-failed",
        "bp-canvas-open-link",
        "bp-canvas-ops",
        "bp-canvas-selection",
        "bp-master-insert",
        "bp-ready",
        "bp-save-master"
      ],
      "host class": [
        "bp-paper-editor"
      ],
      "inbound event": [
        "bp-fleet-paint"
      ],
      "member": [
        "acknowledgeOps",
        "acknowledgedSaves",
        "applyServerBlocks",
        "applyServerBlocksIfIdle",
        "blocks",
        "discardInflightOps",
        "editBlockObject",
        "findClear",
        "focusSelection",
        "hasPendingChanges",
        "identifyOpsRequest",
        "linkPreviewSource",
        "mediaPicker",
        "mediaUploader",
        "recoverySnapshot",
        "redo",
