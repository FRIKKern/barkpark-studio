        "resolveConflictWithServerBlocks",
        "run",
        "selectBlock",
        "setRemoteSelections",
        "state",
        "undo",
        "wikilinkSource"
      ],
      "tag": [
        "bp-paper-canvas"
      ]
    },
    "editor": {
      "attribute": [
        "editable"
      ],
      "event": [
        "bp-ready"
      ],
      "member": [
        "block",
        "focusSelection",
        "hasPendingChanges",
        "wikilinkSource"
      ],
      "tag": [
        "bp-paper-editor"
      ]
    },
    "window": {
      "global": [
        "BP_PAPER_EDITOR_NO_INJECT"
      ]
    },
    "both": {
      "static": [
        "CONTRACT_VERSION"
      ]
    },
    "css": {
      "token": [
        "--bp-evidence-pull",
        "--bp-evidence-width",
        "--bp-section-beat",
        "--bp-section-gap",
        "--bp-section-rule",
        "--bp-table-centre",
        "--paper-accent",
        "--paper-bg",
        "--paper-ink",
        "--paper-ink-faint"
      ]
    }
  },
  "internals": [
    {
      "names": [
        "ProseMirror",
        "ProseMirror-selectednode",
        "bp-block-handle",
        "bp-block-handle__add",
        "bp-block-handle__grip",
        "bp-block-menu",
        "bp-block-menu__item",
        "bp-block-menu__item--danger",
        "bp-canvas-field",
        "bp-canvas-field--bound",
        "bp-canvas-field-badge",
        "bp-canvas-field-binding",
        "bp-canvas-field-control",
        "bp-canvas-field-label",
        "bp-canvas-field-unbind",
        "bp-canvas-image",
        "bp-canvas-image-head",
