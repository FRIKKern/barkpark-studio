{
  "name": "fieldTypes",
  "title": "Field types",
  "visibility": "public",
  "fieldsets": [
    {
      "name": "size",
      "title": "Size",
      "options": {
        "columns": 2
      }
    },
    {
      "name": "more",
      "title": "More",
      "options": {
        "collapsible": true,
        "collapsed": true
      }
    }
  ],
  "initial_values": {
    "count": 3,
    "hiddenNote": "Read the terms"
  },
  "fields": [
    {
      "name": "title",
      "title": "Title",
      "type": "string",
      "validation": {
        "required": true
      }
    },
    {
      "name": "choice",
      "title": "Choice",
      "type": "select",
      "options": [
        {
          "value": "a",
          "title": "Alpha"
        },
        {
          "value": "b",
          "title": "Beta"
        },
        {
          "value": "c",
          "title": "Gamma"
        }
      ]
    },
    {
      "name": "agree",
      "title": "Agree",
      "type": "boolean",
      "options": {
        "layout": "checkbox"
      }
    },
    {
      "name": "day",
      "title": "Day",
      "type": "date",
      "options": {
        "dateFormat": "DD.MM.YYYY"
      },
      "validation": {
        "min": "2020-01-01",
        "max": "2030-12-31"
      }
    },
    {
      "name": "at",
      "title": "At",
      "type": "datetime",
      "options": {
        "dateFormat": "DD.MM.YYYY",
        "timeFormat": "HH:mm",
        "timeStep": 15
      },
      "validation": {
        "min": "2020-01-01T00:00:00Z"
      }
    },
    {
      "name": "meetsAt",
      "title": "Meets at",
      "type": "datetime",
      "options": {
        "displayTimeZone": "America/New_York",
        "allowTimeZoneSwitch": true
      }
    },
    {
      "name": "handle",
      "title": "Handle",
      "type": "slug",
      "options": {
        "source": "title",
        "maxLength": 20
      },
      "validation": {
        "required": true
      }
    },
    {
      "name": "place",
      "title": "Place",
      "type": "geopoint"
    },
    {
      "name": "weakRef",
      "title": "Weak reference",
      "type": "reference",
      "refType": "post",
      "weak": true,
      "options": {
        "disableNew": true
      }
    },
    {
      "name": "colours",
      "title": "Colours",
      "type": "arrayOf",
      "ordered": true,
      "of": {
        "type": "string"
      },
      "options": {
        "list": [
          {
            "value": "red",
            "title": "Red"
          },
          {
            "value": "green",
            "title": "Green"
          },
          {
            "value": "blue",
            "title": "Blue"
          }
        ],
        "layout": "grid"
      }
    },
    {
      "name": "cards",
      "title": "Cards",
      "type": "arrayOf",
      "ordered": true,
      "layout": "grid",
      "of": {
        "type": "composite",
        "name": "card",
        "fields": [
          {
            "name": "label",
            "title": "Label",
            "type": "string"
          },
          {
            "name": "note",
            "title": "Note",
            "type": "text",
            "rows": 2
          }
        ]
      }
    },
    {
      "name": "sections",
      "title": "Sections",
      "type": "arrayOf",
      "ordered": true,
      "of": {
        "type": "composite",
        "name": "section",
        "preview": {
          "title": "title"
        },
        "fields": [
          {
            "name": "title",
            "title": "Title",
            "type": "string"
          },
          {
            "name": "items",
            "title": "Items",
            "type": "arrayOf",
            "ordered": true,
            "of": {
              "type": "composite",
              "name": "item",
              "preview": {
                "title": "label"
              },
              "fields": [
                {
                  "name": "label",
                  "title": "Label",
                  "type": "string"
                },
                {
                  "name": "note",
                  "title": "Note",
                  "type": "text",
                  "rows": 2
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "blocks",
      "title": "Blocks",
      "type": "arrayOf",
      "ordered": true,
      "of": {
        "type": "composite",
        "name": "block",
        "preview": {
          "title": "heading"
        },
        "options": {
          "typeField": "kind",
          "fieldsByType": {
            "hero": [
              "heading"
            ],
            "quote": [
              "heading"
            ],
            "cta": [
              "heading"
            ],
            "stat": [
              "heading"
            ],
            "faq": [
              "heading"
            ],
            "logo": [
              "heading"
            ]
          }
        },
        "fields": [
          {
            "name": "kind",
            "title": "Kind",
            "type": "select",
            "options": [
              {
                "value": "hero",
                "title": "Hero",
                "icon": "image"
              },
              {
                "value": "quote",
                "title": "Quote",
                "icon": "double-quote"
              },
              {
                "value": "cta",
                "title": "Call to action",
                "icon": "rocket"
              },
              {
                "value": "stat",
                "title": "Stat",
                "icon": "bar-chart"
              },
              {
                "value": "faq",
                "title": "FAQ",
                "icon": "help-circle"
              },
              {
                "value": "logo",
                "title": "Logo strip",
                "icon": "star"
              }
            ]
          },
          {
            "name": "heading",
            "title": "Heading",
            "type": "string"
          }
        ]
      },
      "options": {
        "insertMenu": {
          "groups": [
            {
              "name": "content",
              "title": "Content",
              "of": [
                "hero",
                "quote",
                "faq"
              ]
            },
            {
              "name": "marketing",
              "title": "Marketing",
              "of": [
                "cta",
                "stat",
                "logo"
              ]
            }
          ],
          "views": [
            {
              "name": "list"
            },
            {
              "name": "grid"
            }
          ]
        }
      }
    },
    {
      "name": "address",
      "title": "Address",
      "type": "composite",
      "fieldsets": [
        {
          "name": "where",
          "title": "Where",
          "options": {
            "collapsible": true,
            "collapsed": false,
            "columns": 2
          }
        }
      ],
      "fields": [
        {
          "name": "street",
          "title": "Street",
          "type": "string",
          "fieldset": "where"
        },
        {
          "name": "city",
          "title": "City",
          "type": "string",
          "fieldset": "where"
        },
        {
          "name": "zip",
          "title": "Zip",
          "type": "string",
          "validation": {
            "length": 4
          }
        }
      ]
    },
    {
      "name": "width",
      "title": "Width",
      "type": "number",
      "fieldset": "size",
      "validation": {
        "precision": 2,
        "positive": true
      }
    },
    {
      "name": "height",
      "title": "Height",
      "type": "number",
      "fieldset": "size",
      "validation": {
        "greaterThan": 0,
        "lessThan": 10000
      }
    },
    {
      "name": "count",
      "title": "Count",
      "type": "integer",
      "validation": {
        "min": 0,
        "max": 10
      }
    },
    {
      "name": "perPage",
      "title": "Per page",
      "type": "integer",
      "options": {
        "list": [3, 6]
      },
      "layout": "radio"
    },
    {
      "name": "hiddenNote",
      "title": "Shown when agreed",
      "type": "string",
      "visibleWhen": {
        "field": "agree",
        "operator": "eq",
        "value": true
      }
    },
    {
      "name": "lockedNote",
      "title": "Locked when agreed",
      "type": "string",
      "readOnly": {
        "field": "agree",
        "operator": "eq",
        "value": true
      }
    },
    {
      "name": "limit",
      "title": "Limit",
      "type": "number",
      "fieldset": "more",
      "validation": {
        "max": 10
      }
    },
    {
      "name": "attachment",
      "title": "Attachment",
      "type": "file",
      "options": {
        "accept": "image/*"
      }
    },
    {
      "name": "photo",
      "title": "Photo",
      "type": "image",
      "options": {
        "hotspot": true,
        "metadata": [
          "palette",
          "exif"
        ]
      },
      "validation": {
        "assetRequired": true
      }
    },
    {
      "name": "snippet",
      "title": "Snippet",
      "type": "composite",
      "namedType": "code",
      "description": "A code field, as Sanity's @sanity/code-input stores it.",
      "options": {
        "language": "typescript",
        "withFilename": true
      },
      "fields": [
        {
          "name": "language",
          "title": "Language",
          "type": "string"
        },
        {
          "name": "filename",
          "title": "Filename",
          "type": "string"
        },
        {
          "name": "code",
          "title": "Code",
          "type": "text"
        },
        {
          "name": "highlightedLines",
          "title": "Highlighted lines",
          "type": "arrayOf",
          "of": {
            "type": "number"
          }
        }
      ]
    },
    {
      "name": "sizeChart",
      "title": "Size chart",
      "type": "composite",
      "namedType": "table",
      "description": "A table field, as Sanity's @sanity/table stores it.",
      "fields": [
        {
          "name": "rows",
          "title": "Rows",
          "type": "arrayOf",
          "of": {
            "type": "composite",
            "namedType": "tableRow",
            "fields": [
              {
                "name": "cells",
                "title": "Cells",
                "type": "arrayOf",
                "of": {
                  "type": "string"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "name": "steps",
      "title": "Steps",
      "type": "arrayOf",
      "description": "Fixed steps: none removed or duplicated, kept in order, each edited in a popover by its row.",
      "options": {
        "disableActions": [
          "remove",
          "duplicate"
        ],
        "sortable": false,
        "modal": {
          "type": "popover",
          "width": 1
        }
      },
      "of": {
        "type": "composite",
        "name": "step",
        "fields": [
          {
            "name": "label",
            "title": "Label",
            "type": "string"
          },
          {
            "name": "note",
            "title": "Note",
            "type": "text",
            "rows": 2
          }
        ]
      }
    }
  ]
}
