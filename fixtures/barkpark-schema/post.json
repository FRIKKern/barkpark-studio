{
  "name": "post",
  "title": "Post",
  "visibility": "public",
  "groups": [{"name": "content", "title": "Content", "default": true}, {"name": "meta", "title": "Meta"}],
  "initial_values": {"featured": false},
  "list_preview": {"title": "title", "subtitle": "author.name", "media": "mainImage"},
  "desk": {"orderings": [
    {"name": "publishedAtDesc", "title": "Publish date, newest", "field": "publishedAt", "direction": "desc"},
    {"name": "ratingDesc", "title": "Rating, highest", "field": "rating", "direction": "desc"}
  ]},
  "fields": [
    {"name": "title", "title": "Title", "type": "string", "group": "content", "validation": {"required": true, "max": 120}},
    {"name": "slug", "title": "Slug", "type": "slug", "group": "content", "options": {"source": "title"}, "validation": {"required": true}},
    {"name": "excerpt", "title": "Excerpt", "type": "text", "rows": 3, "group": "content", "validation": {"max": 160, "level": "warning", "message": "Long excerpts get cut off in previews"}},
    {"name": "author", "title": "Author", "type": "reference", "refType": "author", "group": "content"},
    {"name": "categories", "title": "Categories", "type": "arrayOf", "ordered": true, "group": "content",
     "of": {"type": "reference", "refType": "category"}},
    {"name": "mainImage", "title": "Main image", "type": "image", "group": "content", "options": {"hotspot": true}, "fields": [{"name": "alt", "title": "Alternative text", "type": "string"}]},
    {"name": "body", "title": "Body", "type": "richText", "editor": "blocks", "group": "content",
     "blocks": {"styles": ["normal", "h1", "h2", "h3", "h4", "h5", "h6", "blockquote"], "lists": ["bullet", "number"],
                "marks": ["strong", "em", "code", "underline", "strikethrough"], "annotations": [{"name": "link"}, {"name": "wikilink"}],
                "of": ["image", "callout"]}},
    {"name": "stage", "title": "Stage", "type": "select", "group": "meta", "layout": "radio",
     "options": ["idea", "writing", "review", "done"]},
    {"name": "format", "title": "Format", "type": "select", "group": "meta",
     "options": [{"value": "article", "title": "Article"}, {"value": "tutorial", "title": "Tutorial"}, {"value": "brief", "title": "News brief"}]},
    {"name": "featuredNote", "title": "Featured note", "type": "string", "group": "meta",
     "visibleWhen": {"field": "featured", "operator": "eq", "value": true}},
    {"name": "reviewNote", "title": "Review note", "type": "text", "rows": 2, "group": "meta",
     "readOnly": {"field": "stage", "operator": "eq", "value": "done"}},
    {"name": "attachment", "title": "Attachment", "type": "file", "group": "meta", "options": {"accept": "application/pdf"}},
    {"name": "links", "title": "Links", "type": "arrayOf", "ordered": true, "group": "meta",
     "of": {"type": "composite", "preview": {"title": "title", "subtitle": "target"}, "fields": [
       {"name": "kind", "title": "Kind", "type": "select", "options": [{"value": "externalLink", "title": "External link"}, {"value": "docLink", "title": "Document link"}]},
       {"name": "title", "title": "Title", "type": "string"},
       {"name": "url", "title": "URL", "type": "url"},
       {"name": "target", "title": "Target", "type": "reference", "refType": "post"}
     ]}},
    {"name": "reviewer", "title": "Reviewer", "type": "reference", "refType": "author", "group": "meta", "options": {"filter": {"name": {"neq": "Alan Turing"}}}},
    {"name": "related", "title": "Related", "type": "reference", "refType": "post", "to": [{"type": "post"}, {"type": "author"}], "refTypeTolerant": true, "group": "meta"},
    {"name": "publishedAt", "title": "Published at", "type": "datetime", "group": "meta"},
    {"name": "featured", "title": "Featured", "type": "boolean", "group": "meta"},
    {"name": "rating", "title": "Rating", "type": "number", "group": "meta", "validation": {"min": 0, "max": 5}},
    {"name": "tags", "title": "Tags", "type": "arrayOf", "ordered": true, "group": "meta", "options": {"layout": "tags"},
     "of": {"type": "string"}},
    {"name": "highlights", "title": "Highlights", "type": "arrayOf", "ordered": true, "group": "meta", "of": {"type": "string"}},
    {"name": "seo", "title": "SEO", "type": "composite", "group": "meta", "options": {"collapsible": true, "collapsed": true}, "fields": [
      {"name": "metaTitle", "title": "Meta title", "type": "string", "validation": {"max": 60}},
      {"name": "metaDescription", "title": "Meta description", "type": "text", "rows": 2, "validation": {"min": 50, "level": "info", "message": "Search results show about 150 characters"}}
    ]}
  ]
}
