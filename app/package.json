{
  "name": "barkpark-studio-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:vercel": "NITRO_PRESET=vercel vite build",
    "check": "tsc --noEmit && pnpm -s test && vite build",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts ../scripts/seed-bulk.test.mjs ../scripts/ci-lease.test.mjs ../scripts/spec-imports.test.mjs ../scripts/lib/seed-map.test.mjs ../scripts/lib/batches.test.mjs ../scripts/lib/remove-type.test.mjs ../scripts/lib/retry.test.mjs ../scripts/lib/dev-tokens.test.mjs ../scripts/lib/seed-plan.test.mjs",
    "serve": "vite build && vite preview --port 3000 --strictPort"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@fontsource-variable/inter": "5.3.0",
    "@lezer/highlight": "1.2.5",
    "@portabletext/editor": "8.2.5",
    "@portabletext/plugin-markdown-shortcuts": "9.0.17",
    "@portabletext/plugin-paste-link": "5.0.16",
    "@portabletext/plugin-typography": "9.0.17",
    "@sanity/diff-match-patch": "^3.2.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.60",
    "json5": "2.2.3",
    "nitro": "3.0.260903-beta",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "speakingurl": "14.0.1",
    "undici": "6.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  },
  "pnpm": {
    "overrides": {
      "@portabletext/plugin-input-rule": "7.0.17",
      "@portabletext/plugin-character-pair-decorator": "9.0.17"
    }
  }
}
