{
  "name": "barkpark-studio-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "BARKPARK_DATASET=${BARKPARK_DATASET:-e2e-local} node --env-file=../.env node_modules/@playwright/test/cli.js test",
    "baseline": "BASELINE=1 BARKPARK_DATASET=${BARKPARK_DATASET:-e2e-local} node --env-file=../.env node_modules/@playwright/test/cli.js test --grep @baseline",
    "reset": "BARKPARK_DATASET=${BARKPARK_DATASET:-e2e-local} node --env-file=../.env ../scripts/seed-barkpark.mjs --data"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5"
  }
}
