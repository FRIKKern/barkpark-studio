# Copy to .env (gitignored). Server-side only — never exposed to the browser.
BARKPARK_URL=https://guerrilla.barkpark.cloud
BARKPARK_TOKEN=
BARKPARK_WORKSPACE=studio-parity
BARKPARK_PROJECT=default
BARKPARK_DATASET=production
# Datasets per writer: production = people poking around, e2e-local = your e2e runs
# (pnpm test sets it), ci = GitHub's runs. Same schema in all three (seed-barkpark).
# Optional: lets scripts/seed-barkpark.mjs verify against the reference Sanity dataset.
SANITY_TOKEN=
# Optional: a second Sanity author for scripts/reference-history.mjs (your `npx sanity debug --secrets` token).
SANITY_TOKEN_B=
# Who editors are (app/src/server/auth.ts). A production build asks for a Barkpark account
# (J67); shared = everyone works as BARKPARK_TOKEN (CI and e2e set it). Dev builds: shared.
# STUDIO_SIGN_IN=account
# Optional, LOCAL DEV ONLY: per-editor tokens without a password (app/src/server/auth.ts).
# Refused by production builds. Never put the admin token in CI or a deploy.
# STUDIO_DEV_LOGIN=1
# BARKPARK_ADMIN_TOKEN=
